<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.content.sync-ical</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/你的用户名/.local/bin/wb-sync-ical.py</string>
    </array>
    <!-- 触发时间 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/wb-sync-ical-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/wb-sync-ical-launchd.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
